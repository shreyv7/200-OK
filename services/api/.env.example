ENV=local
# AUTH_BYPASS is honored only when ENV=local (pytest / local smoke). Never true in staging/prod.
AUTH_BYPASS=true
DEMO_USER_ID=demo-user-aarav

DATABASE_URL=postgresql+psycopg://trellis:trellis@localhost:5432/trellis
REDIS_URL=redis://localhost:6379/0

CLERK_JWKS_URL=
CLERK_ISSUER=
# Optional — only if your Clerk JWT template sets `aud`
CLERK_AUDIENCE=
# Comma-separated frontend origins allowed in JWT `azp` claim
CLERK_AUTHORIZED_PARTIES=http://localhost:8080,http://localhost:5173
