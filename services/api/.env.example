ENV=local
# AUTH_BYPASS is honored only when ENV=local (pytest / local smoke). Never true in staging/prod.
AUTH_BYPASS=true
DEMO_USER_ID=demo-user-aarav
# Explicit opt-in for `python -m app.workers.seed` (never enable in staging/prod)
ALLOW_DEMO_SEED=false
# Optional: `python -m app.workers.prewarm` target user id
PREWARM_USER_ID=

DATABASE_URL=postgresql+psycopg://trellis:trellis@localhost:5432/trellis
REDIS_URL=redis://localhost:6379/0

CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
# Optional — only if your Clerk JWT template sets `aud`
CLERK_AUDIENCE=
# Comma-separated frontend origins allowed in JWT `azp` claim
CLERK_AUTHORIZED_PARTIES=http://localhost:8080,http://localhost:5173,http://localhost:3000
# A6 — browser CORS allow-list (see docs/env-matrix.md)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Person C — live retrieval (Tavily + YouTube)
SEARCH_PROVIDER=fake
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=1.5
YOUTUBE_API_KEY=
YOUTUBE_TIMEOUT_SECONDS=2.0

# Person D — OAuth token encryption + provider credentials
TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8002/api/v1/integrations/google-calendar/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8002/api/v1/integrations/github/callback

# LLM provider (app/core/di.py). Leave unset locally/CI so tests and dev
# keep using the deterministic FakeLLMProvider (docs/work.md ground rule 5).
# In staging/production set LLM_PROVIDER=gemini and provide a real key —
# never leave LLM_PROVIDER=fake outside local/test envs.
LLM_PROVIDER=fake
GEMINI_API_KEY=
# Optional extra keys for round-robin rotation across quota pools
# (docs/work.md B2), comma-separated. Only helps if each key belongs to
# a different Google Cloud project/billing account — keys sharing one
# project share one quota, so rotating between them does not add headroom.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.0-flash

# Bedrock failover (docs/work.md B3). Off by default -- untested against
# a live AWS account. Set all three plus BEDROCK_FAILOVER_ENABLED=true to
# have a fully-exhausted Gemini key pool automatically retry on Bedrock.
BEDROCK_FAILOVER_ENABLED=false
BEDROCK_REGION=
BEDROCK_MODEL_ID=

# Per-user daily LLM call cap (docs/work.md B5). Applies regardless of
# which underlying provider serves a call. Never applied to the fake
# provider (it costs nothing).
LLM_DAILY_CALL_CAP=200
